# pnpm store/cache redirection.
#
# WHY THIS FILE EXISTS: in this sandboxed Codespace the container $HOME is
# mounted read-only, so pnpm's default store (~/.local/share/pnpm) and cache
# (~/.cache/pnpm) are unwritable and every install fails with EROFS. Pointing
# both at workspace-relative paths keeps installs working and keeps the store on
# the same filesystem as the projects, so pnpm hard-links instead of copying.
#
# Both directories are git-ignored (.gitignore) so they never enter history.
store-dir=.pnpm-store
cache-dir=.pnpm-cache

# Deterministic, CI-friendly installs. Do not change without updating
# AGENT_RULES.md.
prefer-frozen-lockfile=true
strict-peer-dependencies=false
