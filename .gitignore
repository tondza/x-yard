# Dependencies
node_modules/

# pnpm content-addressable store + cache.
# These live inside the repo on purpose: in this sandboxed Codespace the
# container's $HOME is read-only, so pnpm's default (~/.local/share/pnpm,
# ~/.cache/pnpm) cannot be written. Redirecting the store into the workspace
# also keeps it on the same filesystem as the projects, so pnpm can use hard
# links instead of falling back to slow copies. See AGENT_RULES.md.
.pnpm-store/
.pnpm-cache/

# Build output
dist/
build/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/
.vite/

# Machine-readable Vitest report. Consumed by scripts/check-docs.mjs to verify
# that the test counts claimed in the governance documents are true.
.vitest-report.json

# Environment
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
*.swp

# Design-mockup screenshot tooling. Kept OUT of the pnpm workspace and the app
# dependency graph on purpose: nothing here is needed to build, test, or run
# X-Yard. See design/moodboard/README.md.
.tools/
.playwright-browsers/
.chromium-libs/
.apt/

# Renders are work artifacts, not repository content. Mockup sources
# (html/css/js) are committed; their output is regenerated locally with the
# moodboard tooling. Contact sheets only wrap renders, so they are artifacts
# too. See design/moodboard/README.md.
design/**/*.png
design/**/*.jpg
design/**/*.jpeg
design/**/*.webp
design/**/compare*.html
maps/shots/

# Local dev-host helpers (Codespace-specific, not project code)
fix-502.sh
fix-proxy.sh
start-dsh.sh

# Scratch snapshots
.git-status-before.txt
